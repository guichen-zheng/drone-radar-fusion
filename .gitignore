__pycache__/
*.py[cod]
*.egg-info/
*.egg

# ── clangd / 编辑器索引 ────────────────────────────────────────────────────
.cache/
.vscode/
.idea/
compile_commands.json

# ── rosbag 录制目录（如果 ~/bags 不是软链到这里，下面这条不影响）────────
bags/

