<?xml version="1.0"?>
<sdf version="1.6">
  <world name="drone_sim">

    <!-- libgazebo_ros_state 插件：提供 /gazebo/set_entity_state 服务 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>100.0</update_rate>
    </plugin>

    <!-- 方向光 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.35 0.45 0.35 1</ambient>
            <diffuse>0.35 0.45 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 传感器云台（内联简化版，避免 model:// 加载慢） -->
    <model name="sensor_unit">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <!-- 立柱 -->
        <visual name="pole">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
        <!-- 顶板 -->
        <visual name="top">
          <pose>0 0 1.32 0 0 0</pose>
          <geometry><box><size>0.28 0.20 0.04</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <!-- 雷达（深灰矩形） -->
        <visual name="radar">
          <pose>0 0 1.40 0 0 0</pose>
          <geometry><box><size>0.16 0.16 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <!-- 雷达橙色标志 -->
        <visual name="radar_stripe">
          <pose>0.081 0 1.40 0 0 0</pose>
          <geometry><box><size>0.002 0.16 0.06</size></box></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
        <!-- 相机（黑色圆柱） -->
        <visual name="camera">
          <pose>0 0.13 1.40 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.032</radius><length>0.09</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <!-- 三脚架腿 x3：三条腿 roll 相同(0.983)，yaw 相差 120° -->
        <visual name="leg_a">
          <pose>0.0 0.225 0.15 0.983 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.54</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_b">
          <pose>-0.195 -0.112 0.15 0.983 0 2.094</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.54</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_c">
          <pose>0.195 -0.112 0.15 0.983 0 4.189</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.54</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>

        <!-- ============================================================ -->
        <!-- RGB 相机传感器（替代真实海康相机，发布 /hik_camera/image_raw） -->
        <!-- 内参与 config/sim_calib.yaml 一致：fx=fy=1000, cx=1224, cy=1024 -->
        <!-- horizontal_fov = 2*atan(cx/fx) = 2*atan(1224/1000) ≈ 1.8847 rad -->
        <!-- ============================================================ -->
        <sensor name="rgb_camera" type="camera">
          <pose>0 0.13 1.40 0 0 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.8847</horizontal_fov>
            <image>
              <width>2448</width>
              <height>2048</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>500</far></clip>
          </camera>
          <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
            <camera_name>hik_camera</camera_name>
            <frame_name>camera_optical</frame_name>
          </plugin>
        </sensor>

        <!-- ============================================================ -->
        <!-- 激光雷达传感器（替代 Livox Avia，发布 /livox/lidar 点云） -->
        <!-- Avia 近似：水平 ±60° (120° FOV)，垂直 ±35° (70° FOV)，量程 200m -->
        <!-- ============================================================ -->
        <sensor name="livox_lidar" type="ray">
          <pose>0 0 1.40 0 0 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-1.047</min_angle>
                <max_angle>1.047</max_angle>
              </horizontal>
              <vertical>
                <samples>128</samples>
                <resolution>1</resolution>
                <min_angle>-0.611</min_angle>
                <max_angle>0.611</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.5</min>
              <max>200</max>
              <resolution>0.05</resolution>
            </range>
          </ray>
          <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/livox</namespace>
              <remapping>~/out:=lidar</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud2</output_type>
            <frame_name>lidar</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- 无人机（由 sim_bridge 通过 set_entity_state 实时移动） -->
    <!-- 三架同型号无人机，初始位置都在 +X 侧（相机正前方），不同半径/高度。 -->
    <include>
      <uri>model://drone</uri>
      <name>drone</name>
      <pose>15 -5 7 0 0 0</pose>
    </include>
    <include>
      <uri>model://drone</uri>
      <name>drone2</name>
      <pose>22 0 12 0 0 0</pose>
    </include>
    <include>
      <uri>model://drone</uri>
      <name>drone3</name>
      <pose>28 9 17 0 0 0</pose>
    </include>

    <!-- 物理设置 -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- 背景 -->
    <scene>
      <ambient>0.5 0.6 0.6 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <sky><clouds><speed>8</speed></clouds></sky>
    </scene>

  </world>
</sdf>
