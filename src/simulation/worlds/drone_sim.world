<?xml version="1.0"?>
<sdf version="1.6">
  <world name="drone_sim">

    <!-- 光照 -->
    <include><uri>model://sun</uri></include>

    <!-- 地面 -->
    <include><uri>model://ground_plane</uri></include>

    <!-- 初始无人机（位置由 sim_bridge 通过 SetEntityState 实时更新） -->
    <include>
      <uri>model://drone</uri>
      <name>drone</name>
      <pose>20 0 20 0 0 0</pose>
    </include>

    <!-- 物理设置（禁用实时倍速限制以免影响仿真速度） -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- 背景天空 -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <sky>
        <clouds><speed>12</speed></clouds>
      </sky>
    </scene>

  </world>
</sdf>
