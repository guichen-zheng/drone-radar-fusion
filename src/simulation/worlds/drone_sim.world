<?xml version="1.0"?>
<sdf version="1.6">
  <world name="drone_sim">

    <!-- libgazebo_ros_state 插件：提供 /gazebo/set_entity_state 服务 -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>100.0</update_rate>
    </plugin>

    <!-- 方向光 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.5 -1.0</direction>
    </light>

    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.35 0.45 0.35 1</ambient>
            <diffuse>0.35 0.45 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ────────────────────────────────────────────────────────────────── -->
    <!-- sensor_pillar：脚架 + 立柱 + 雷达（静态，永远不动）               -->
    <!-- 雷达固定在立柱顶端（世界 z=1.55），360° 全向扫描，持续看到全部无人机 -->
    <!-- 只有相机（sensor_head）跟着云台转 → 主动注视；雷达保持宽域稳定粗检 -->
    <!-- ────────────────────────────────────────────────────────────────── -->
    <model name="sensor_pillar">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <!-- 立柱 -->
        <visual name="pole">
          <pose>0 0 0.65 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
        <!-- 雷达本体（深灰矩形，固定在立柱顶端 z=1.55） -->
        <visual name="radar_body">
          <pose>0 0 1.55 0 0 0</pose>
          <geometry><box><size>0.16 0.16 0.06</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
        <!-- 顶板 -->
        <visual name="top">
          <pose>0 0 1.32 0 0 0</pose>
          <geometry><box><size>0.28 0.20 0.04</size></box></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <!-- 云台底座（小圆台，标识旋转中心） -->
        <visual name="gimbal_base">
          <pose>0 0 1.50 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
        <!-- 三脚架腿 x3：三条腿 roll 相同(0.983)，yaw 相差 120° -->
        <visual name="leg_a">
          <pose>0.0 0.225 0.15 0.983 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.54</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_b">
          <pose>-0.195 -0.112 0.15 0.983 0 2.094</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.54</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="leg_c">
          <pose>0.195 -0.112 0.15 0.983 0 4.189</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.54</length></cylinder></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>

        <!-- ============================================================ -->
        <!-- 激光雷达传感器（静态，发布 /livox/lidar 点云）               -->
        <!-- 位于立柱顶端 (0,0,1.55)，与世界坐标轴对齐，永远不动           -->
        <!-- 水平 360° 全向 + 垂直 0°~+48°（只朝上看天空）：                -->
        <!-- 无人机都在雷达上方 19°~28° 仰角，向上扫避免射线打到地面产生海量 -->
        <!-- 杂波点（曾达 4.5 万点拖垮聚类）。向上扫后点云只剩无人机本身。     -->
        <!-- ============================================================ -->
        <sensor name="livox_lidar" type="ray">
          <pose>0 0 1.55 0 0 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>96</samples>
                <resolution>1</resolution>
                <min_angle>0.0</min_angle>
                <max_angle>0.838</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.5</min>
              <max>200</max>
              <resolution>0.05</resolution>
            </range>
          </ray>
          <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/livox</namespace>
              <remapping>~/out:=lidar</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud2</output_type>
            <frame_name>lidar</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- ────────────────────────────────────────────────────────────────── -->
    <!-- sensor_head：仅相机，由 gimbal_controller 通过                     -->
    <!-- /gazebo/set_entity_state 旋转，模拟 2-DOF PT 云台（主动注视）      -->
    <!-- 旋转中心（pivot）：世界 (0, 0, 1.55)，与雷达同高                  -->
    <!-- 模型坐标系：原点=旋转中心                                         -->
    <!--   相机光学中心：模型 (0, 0, 0.07)，比雷达高 7cm                    -->
    <!--   光轴沿模型 +x 方向，随云台 pan/tilt 转动                         -->
    <!-- 雷达已移到 sensor_pillar（静态），不再随云台转                     -->
    <!-- ────────────────────────────────────────────────────────────────── -->
    <model name="sensor_head">
      <pose>0 0 1.55 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <!-- 相机本体（黑色圆柱，位于云台中心上方 7cm，朝 +x） -->
        <visual name="camera_body">
          <pose>0 0 0.07 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.032</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <!-- 镜头（前端蓝色圆盘） -->
        <visual name="camera_lens">
          <pose>0.055 0 0.07 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.005</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.25 1</ambient><diffuse>0.1 0.1 0.4 1</diffuse></material>
        </visual>

        <!-- ============================================================ -->
        <!-- RGB 相机传感器（发布 /hik_camera/image_raw）                 -->
        <!-- 内参与 config/sim_calib.yaml 一致：fx=fy=1000, cx=1224, cy=1024 -->
        <!-- 位于雷达上方 7cm，光轴沿模型 +x，跟着模型一起旋转            -->
        <!-- ============================================================ -->
        <sensor name="rgb_camera" type="camera">
          <pose>0 0 0.07 0 0 0</pose>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.8847</horizontal_fov>
            <image>
              <width>2448</width>
              <height>2048</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>500</far></clip>
          </camera>
          <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
            <camera_name>hik_camera</camera_name>
            <frame_name>camera_optical</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- 无人机（由 sim_bridge 通过 set_entity_state 实时移动） -->
    <!-- 三架同型号无人机，初始位置都在 +X 侧（相机正前方），不同半径/高度。 -->
    <include>
      <uri>model://drone</uri>
      <name>drone</name>
      <pose>15 -5 7 0 0 0</pose>
    </include>
    <include>
      <uri>model://drone</uri>
      <name>drone2</name>
      <pose>22 0 12 0 0 0</pose>
    </include>
    <include>
      <uri>model://drone</uri>
      <name>drone3</name>
      <pose>28 9 17 0 0 0</pose>
    </include>

    <!-- 物理设置 -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- 背景 -->
    <scene>
      <ambient>0.5 0.6 0.6 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <sky><clouds><speed>8</speed></clouds></sky>
    </scene>

  </world>
</sdf>
