<?xml version="1.0"?>
<sdf version="1.6">
  <model name="drone">
    <static>false</static>
    <link name="base_link">
      <gravity>0</gravity>
      <kinematic>1</kinematic>
      <inertial>
        <mass>1.5</mass>
        <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>

      <!-- 真实四旋翼 mesh（OSRF gazebo_models/quadrotor 衍生，BSD 协议） -->
      <!-- 放大 4 倍：原 mesh ~50cm，scale=4 后约 2m，便于远距离 YOLO 识别 -->
      <visual name="body">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://drone/meshes/quadrotor.dae</uri>
            <scale>4.0 4.0 4.0</scale>
          </mesh>
        </geometry>
      </visual>

      <!-- 碰撞体（保持原样大小，不参与渲染） -->
      <collision name="collision">
        <geometry><box><size>2.5 2.5 0.6</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
