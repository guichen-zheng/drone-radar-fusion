Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 参考网格
      Enabled: true
      Cell Size: 5
      Color: 130; 130; 130
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/Axes
      Name: 坐标系原点
      Enabled: true
      Length: 3
      Radius: 0.12
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/MarkerArray
      Name: 无人机模型（sim_bridge）
      Enabled: true
      Topic:
        Value: /sim/drone_visual
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile

    - Class: rviz_default_plugins/MarkerArray
      Name: 传感器云台（sim_bridge）
      Enabled: true
      Topic:
        Value: /sim/sensor_visual
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile

    - Class: rviz_default_plugins/MarkerArray
      Name: 融合目标（fusion_manager）
      Enabled: true
      Topic:
        Value: /fusion/markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile

    - Class: rviz_default_plugins/MarkerArray
      Name: 禁飞区提醒激光（gimbal）
      Enabled: true
      Topic:
        Value: /gimbal/laser
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile

  Enabled: true
  Global Options:
    Background Color: 15; 15; 25
    Fixed Frame: lidar
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 65
      Focal Point:
        X: 0
        Y: 0
        Z: 15
      Name: Current View
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.6
